# Browser-visible GETRA configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MAPID_BASEMAP_KEY=
NEXT_PUBLIC_MAPID_STYLE_NAME=basic

# The browser calls this frontend origin. Keep it aligned with the local dev URL.
NEXT_PUBLIC_GETRA_API_URL=http://localhost:3000

# Server-only BFF target. Team mode uses the shared HTTPS backend.
GETRA_BACKEND_INTERNAL_URL=https://getra-routing-api.tail0ed517.ts.net

# Owner local mode alternative:
# GETRA_BACKEND_INTERNAL_URL=http://localhost:8080
