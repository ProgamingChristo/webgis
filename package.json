{
  "name": "getra-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "displayName": "GETRA",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "ts-api-utils": "2.4.0"
  },
  "scripts": {
    "dev": "node scripts/dev-getra.mjs",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "next build",
    "start": "next start",

    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",

    "test": "vitest run",
    "test:watch": "vitest",

    "preprocess:start": "npm run build",
    "process:start": "pm2 start ecosystem.config.cjs --only getra-backend --update-env",

    "preprocess:restart": "npm run build",
    "process:restart": "pm2 restart ecosystem.config.cjs --only getra-backend --update-env",

    "process:stop": "pm2 stop getra-backend",
    "process:status": "pm2 status getra-backend",
    "process:logs": "pm2 logs getra-backend",

    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local",
    "db:migrations": "supabase migration list --local",

    "docker:build": "docker compose --env-file .env.local build",
    "docker:start": "docker compose --env-file .env.local up -d",
    "docker:stop": "docker compose --env-file .env.local down",
    "docker:restart": "docker compose --env-file .env.local restart",
    "docker:status": "docker compose --env-file .env.local ps",
    "docker:logs": "docker compose --env-file .env.local logs -f --tail 100",
    "docker:prod:start": "docker compose --env-file .env.local -f docker-compose.yml -f docker-compose.prod.yml up -d --build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@supabase/supabase-js": "^2.112.3",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.3.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "pm2": "^7.0.3",
    "supabase": "^2.114.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
