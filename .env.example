# FRONTEND PROJECT PUBLIC VARIABLES
# Local file: frontend/.env.local. Vercel project: GETRA frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GETRA_API_URL=http://localhost:8080
# NEXT_PUBLIC_API_URL is a deprecated compatibility alias; do not use for new deployments.

# DOCKER BACKEND APPLICATION VARIABLES
# Local development: backend/.env.local. Docker/VPS: ignored root .env.local,
# consumed by Compose at container startup. The backend is not deployed to Vercel.

# Backend deployment and strict browser-origin allowlist (comma-separated origins).
APP_ENV=
APP_BASE_URL=
FRONTEND_ALLOWED_ORIGINS=
TRUST_PROXY=
GETRA_BIND_ADDRESS=127.0.0.1
GETRA_DOCKER_PORT=3002

# API operational security. Blank values use validated safe defaults.
API_MAX_JSON_BODY_BYTES=1048576
SUPABASE_REQUEST_TIMEOUT_MS=
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_AUTH_REGISTER_MAX_REQUESTS=
RATE_LIMIT_AUTH_LOGIN_MAX_REQUESTS=
RATE_LIMIT_AUTH_GENERAL_MAX_REQUESTS=
RATE_LIMIT_API_MAX_REQUESTS=
RATE_LIMIT_AI_MAX_REQUESTS=15
RATE_LIMIT_AI_WINDOW_MS=600000
RATE_LIMIT_MUTATION_MAX_REQUESTS=
RATE_LIMIT_SPATIAL_MAX_REQUESTS=

# Public MAPID GL Style basemap configuration (bundled into the browser).
NEXT_PUBLIC_MAPID_BASEMAP_KEY=
NEXT_PUBLIC_MAPID_STYLE_NAME=basic

# Reserved for a future server-only use case. Do not expose this as NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Development and smoke test credentials. Never commit real credentials.
GETRA_TEST_USER_PASSWORD=

# Server-only MAPID integration placeholders. Official provider contract pending.
MAPID_BASE_URL=
MAPID_API_KEY=
MAPID_ACTIVITIES_PATH=/web/competition/activities
MAPID_TIMEOUT_MS=

# Server-only spatial engine operational limits. Blank values use documented defaults.
SPATIAL_MAX_RADIUS_METERS=
SPATIAL_MAX_BBOX_LATITUDE_DEGREES=
SPATIAL_MAX_BBOX_LONGITUDE_DEGREES=
DEFAULT_WALKING_SPEED_MPS=

# Server-only Valhalla navigation configuration.
ROUTING_PROVIDER=valhalla
ROUTING_BASE_URL=http://127.0.0.1:8002
ROUTING_TIMEOUT_MS=12000
ROUTING_CACHE_TTL_MS=300000
VALHALLA_PORT=8002
VALHALLA_BIND_ADDRESS=127.0.0.1
VALHALLA_SERVER_THREADS=2
VALHALLA_FORCE_REBUILD=False

# Midtrans Sandbox Payment Configuration (Server-Only Secrets; never expose to NEXT_PUBLIC_)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SANDBOX_TEST_AMOUNT_IDR=50000

# Midtrans Frontend Client Configuration (Browser-allowed Client Key only)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# Backend-only Sub2API Responses-compatible provider. Never prefix these with NEXT_PUBLIC_.
AI_PROVIDER=sub2api
SUB2API_API_KEY=
SUB2API_MODEL=claude-sonnet-4-6
SUB2API_BASE_URL=https://api.mwapi.dev/v1
SUB2API_TIMEOUT_MS=20000
